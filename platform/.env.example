NODE_ENV=development
PORT=3000

# Public URLs. In local development these can both point at the same server.
PUBLIC_SITE_URL=https://shotwell.ai
AUTH_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Required in production. Use at least 32 random bytes.
SESSION_SECRET=replace-with-strong-random-secret

# Present in ~/labeling_onboarding/.env today. The first implementation uses
# in-memory storage by default; set AUTH_STORE=postgres after running migrations.
AUTH_STORE=memory
DATABASE_URL=

# Add these after creating the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# Development-only email login. In production this should become magic-link or
# OTP delivery through an email provider before enabling.
ALLOW_DEV_EMAIL_LOGIN=true
